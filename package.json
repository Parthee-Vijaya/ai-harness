{
  "name": "aura-harness",
  "version": "0.2.0-beta.6",
  "description": "Aura i terminalen: kodeagent, skills, godkendelser og lokale projekter",
  "license": "EUPL-1.2",
  "private": true,
  "bin": { "aura": "cli/aura.cjs" },
  "engines": { "node": ">=22.12.0" },
  "optionalDependencies": {
    "@opencode/cli-darwin-arm64": "2.1.4",
    "@opencode/cli-darwin-x64-baseline": "2.1.4",
    "@opencode/cli-windows-arm64": "2.1.4",
    "@opencode/cli-windows-x64-baseline": "2.1.4",
    "@opencode/cli-linux-arm64": "2.1.4",
    "@opencode/cli-linux-arm64-musl": "2.1.4",
    "@opencode/cli-linux-x64-baseline": "2.1.4",
    "@opencode/cli-linux-x64-baseline-musl": "2.1.4"
  },
  "files": ["cli/*.cjs", "cli/*.md", "desktop/core/*.cjs", "desktop/core/local-tools-*", "desktop/core/privacy/*.cjs", "desktop/privacy/isolation/*.cjs", "desktop/privacy/isolation/*.c", "desktop/ui/conversation-mode.js", "desktop/ui/plan-view.js", "desktop/runtime-lock.json", "profiles/", "scripts/harness.cjs", "LICENSE"],
  "scripts": {
    "check": "node scripts/check.cjs",
    "package:cli": "node scripts/build-cli-release.cjs",
    "test:cli": "node --test --test-concurrency=1 cli/tests/*.test.cjs",
    "test:cli-live": "node cli/tests/verify-cli.cjs"
  },
  "dependencies": { "undici": "7.30.1" }
}
